---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/i18n/config';
import { localePath, useTranslations } from '@/i18n/utils';
import Badge from '@/components/ui/Badge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}
const { project, locale } = Astro.props;
const t = useTranslations(locale);
const slug = project.id.split('/').slice(1).join('/');
const href = localePath(locale, `/projects/${slug}`);
---

<!-- Flat hover, in the site's own hairline language: the border darkens to ink
     and the bottom bar floods, so nothing about the card floats or scales. -->
<article
  class="group border-line hover:border-ink focus-within:border-ink relative flex flex-col border transition-colors duration-[250ms]"
  data-reveal
>
  <a
    href={href}
    class="absolute inset-0 z-10"
    aria-label={project.data.title}
    data-astro-prefetch="hover"></a>

  <Image
    src={project.data.cover}
    alt=""
    widths={[480, 768, 1200]}
    sizes="(min-width: 1024px) 560px, 100vw"
    class="border-line aspect-video w-full border-b object-cover"
    transition:name={`cover-${slug}`}
  />

  <div class="p-6 sm:p-7">
    <div class="text-ink-faint flex items-center gap-3 font-mono text-xs tracking-wide">
      <span>{project.data.year}</span>
      <span aria-hidden="true">·</span>
      <span>{project.data.role}</span>
    </div>
    <h3
      class="font-display text-ink group-hover:text-accent mt-2 text-xl font-semibold tracking-tight transition-colors sm:text-2xl"
      transition:name={`title-${slug}`}
    >
      {project.data.title}
    </h3>
    <p class="text-ink-muted mt-2.5 leading-relaxed">{project.data.summary}</p>

    <div class="mt-4 flex flex-wrap gap-2">
      {project.data.tech.slice(0, 5).map((item) => <Badge>{item}</Badge>)}
    </div>
  </div>

  <div
    class="cell-flood-group border-line mt-auto flex items-center justify-between border-t px-6 py-3.5 font-mono text-xs tracking-[0.15em] uppercase sm:px-7"
  >
    <span>{t('projects.viewCase')}</span>
    <span aria-hidden="true">→</span>
  </div>
</article>
