---
import { getCollection } from 'astro:content';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = (await getCollection('projects', (entry) => entry.id.startsWith(`${locale}/`)))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="scroll-mt-20 py-16 sm:py-24" id="projects">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading heading={t('projects.heading')} />
  </div>

  <!-- The one section that breaks the max-w-6xl rhythm: a full-bleed band of
       hairline cells. The cards carry the grid lines themselves; the wrapper
       only closes the bottom edge when an odd count leaves the last row half
       empty. -->
  <div class="border-line grid border-b md:grid-cols-2">
    {projects.map((project) => <ProjectCard {project} {locale} />)}
  </div>
</section>
